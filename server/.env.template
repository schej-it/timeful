# Google oauth 
# - Create a Google Cloud project, create credentials for a "web application", and put the client id and secret here
# - Your project should have the following scopes: 
#     "./auth/calendar.events.readonly"
#     "./auth/calendar.calendarlist.readonly"
#     "./auth/contacts.readonly"
#     "./auth/directory.readonly"
CLIENT_ID=?
CLIENT_SECRET=?
ANDROID_CLIENT_ID=? # unused
IOS_CLIENT_ID=? # unused

# GCloud
# - Create a service account in Google Cloud with Cloud Task permissions and put the key file here
SERVICE_ACCOUNT_KEY_PATH=? # optional

# Discord bot 
DISCORD_BOT_TOKEN=? # unused
GUILD_ID=? # unused

# Slack bot
SLACK_DEV_WEBHOOK_URL=? # optional
SLACK_PROD_WEBHOOK_URL=? # optional
SLACK_SIGNING_SECRET=? # optional, from the Slack app's Basic Information page. /api/slackbot rejects all requests without it

# Mailchimp
MAILCHIMP_API_KEY=? # unused

# Mailjet
MAILJET_API_KEY=? # unused
MAILJET_API_SECRET=? # unused
MAILJET_LIST_ID=? # unused

# Listmonk 
LISTMONK_URL=? # optional
LISTMONK_USERNAME=? # optional
LISTMONK_PASSWORD=? # optional
LISTMONK_LIST_ID=? # optional
LISTMONK_INITIAL_EMAIL_REMINDER_ID=? # optional
LISTMONK_SECOND_EMAIL_REMINDER_ID=? # optional
LISTMONK_FINAL_EMAIL_REMINDER_ID=? # optional
LISTMONK_OTP_EMAIL_TEMPLATE_ID=? # required for email OTP auth

# Gmail
GMAIL_APP_PASSWORD=? # optional
SCHEJ_EMAIL_ADDRESS=? # optional

# Encryption
ENCRYPTION_KEY=? # Used to encrypt and decrypt sensitive data

# Session
# - Generate a random 32+ character string for session cookie encryption
# - Example generation: openssl rand -base64 32
SESSION_SECRET=?

# CORS
# - Comma-separated list of allowed origins
# - For local development, set to: http://localhost:8080
CORS_ORIGINS=?

# Reverse proxy
# - Comma-separated IPs/CIDRs of the reverse proxies allowed to set X-Forwarded-For (used for rate limiting)
# - Defaults to loopback and private ranges, which covers a proxy on the same host or Docker network
TRUSTED_PROXIES=? # optional

# MongoDB (all optional; left commented out so copying this template keeps the defaults)
# - Connection string. Timeouts set in the URI (e.g. ?serverSelectionTimeoutMS=5000) take precedence over the variables below
# MONGODB_URI=mongodb://localhost
# - Timeouts are Go durations (5s, 1500ms). An invalid value stops the server at startup. See DEPLOYMENT.md for why each default was chosen
# MONGODB_SERVER_SELECTION_TIMEOUT=5s # how long a request waits for a reachable MongoDB
# MONGODB_CONNECT_TIMEOUT=5s # TCP dial and heartbeat timeout
# MONGODB_SOCKET_TIMEOUT=15s # limit for a single read/write, 0 disables
# MONGODB_HEALTH_TIMEOUT=2s # deadline for /api/health
# MONGODB_STARTUP_TIMEOUT=30s # startup retry time before running in degraded mode
